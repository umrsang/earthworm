{
  "name": "jufun-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.3.0",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"pnpm run dev:serve\" \"pnpm run dev:client\"",
    "dev:serve": "pnpm -F @jufun/api start:dev",
    "dev:client": "pnpm -F @jufun/client dev",
    "db:sync": "pnpm -F @jufun/db sync",
    "db:generate": "pnpm -F @jufun/db generate",
    "pack:courses": "pnpm -F @jufun/course-pack pack:all",
    "build": "pnpm -r run build",
    "format": "prettier --write .",
    "init": "pnpm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  }
}
